{
  "name": "mermaid_sequence_diagram",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "cypress run",
    "electron:dev": "concurrently -k -s first \"node server.js\" \"wait-on tcp:3000 && electron .\"",
    "electron:prepare": "node scripts/prepare-standalone.js",
    "electron:pack": "npm run build && npm run electron:prepare && electron-builder --dir",
    "electron:build": "npm run build && npm run electron:prepare && electron-builder",
    "electron:build:mac": "npm run build && npm run electron:prepare && electron-builder --mac",
    "electron:build:win": "npm run build && npm run electron:prepare && electron-builder --win",
    "electron:build:linux": "npm run build && npm run electron:prepare && electron-builder --linux"
  },
  "build": {
    "appId": "com.mermaid.sequenceviewer",
    "productName": "Mermaid Sequence Viewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "chokidar": "^5.0.0",
    "lucide-react": "^1.51.0",
    "marked": "^16.4.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.1.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-zoom-pan-pinch": "^4.2.0",
    "remark-parse": "^11.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.12.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.3",
    "concurrently": "^10.0.6",
    "cypress": "^16.1.1",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^30.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
